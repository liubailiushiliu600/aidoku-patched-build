 }
+
+// MARK: Folder Import
+extension LocalFileManager {
+    // 取某个文件夹里(不递归)的图片, 按文件名自然排序
+    private func imagesIn(_ folder: URL) -> [URL] {
+        let contents = (try? FileManager.default.contentsOfDirectory(
+            at: folder,
+            includingPropertiesForKeys: [.isRegularFileKey],
+            options: [.skipsHiddenFiles]
+        )) ?? []
+        return contents
+            .filter { url in
+                url.isFileURL && Self.allowedImageExtensions.contains(url.pathExtension.lowercased())
+            }
+            .sorted {
+                $0.lastPathComponent.localizedStandardCompare($1.lastPathComponent) == .orderedAscending
+            }
+    }
+
+    // 取某个文件夹里的子文件夹, 按名称自然排序
+    private func subfoldersIn(_ folder: URL) -> [URL] {
+        let contents = (try? FileManager.default.contentsOfDirectory(
+            at: folder,
+            includingPropertiesForKeys: [.isDirectoryKey],
+            options: [.skipsHiddenFiles]
+        )) ?? []
+        return contents
+            .filter { url in
+                url.isFileURL && (try? url.resourceValues(forKeys: [.isDirectoryKey]).isDirectory) == true
+            }
+            .sorted {
+                $0.lastPathComponent.localizedStandardCompare($1.lastPathComponent) == .orderedAscending
+            }
+    }
+
+    // 文件名里不能出现的字符统一替换掉
+    private func sanitize(_ name: String) -> String {
+        let invalid = CharacterSet(charactersIn: "/\\:*?\"<>|")
+        let cleaned = name.components(separatedBy: invalid).joined(separator: "-")
+        return cleaned.isEmpty ? "untitled" : cleaned
+    }
+
+    // 把一组图片打包成一个临时 cbz
+    // 注意: 必须放在临时目录的"子目录"里, 否则 uploadFile 内部再次拷贝时会和自身撞路径
+    private func makeTemporaryArchive(images: [URL]) throws -> URL {
+        let tempDir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("aidoku-folder-import", isDirectory: true)
+        tempDir.createDirectory()
+
+        let archiveURL = tempDir.appendingPathComponent("\(UUID().uuidString).cbz")
+        let archive = try Archive(url: archiveURL, accessMode: .create)
+
+        let width = max(4, String(images.count).count)
+        for (index, image) in images.enumerated() {
+            var number = String(index + 1)
+            while number.count < width {
+                number = "0" + number
+            }
+            try archive.addEntry(
+                with: "\(number).\(image.pathExtension.lowercased())",
+                relativeTo: image.deletingLastPathComponent()
+            )
+        }
+        return archiveURL
+    }
+
+    // 导入一个文件夹, 返回成功导入的本数
+    // 规则一: 文件夹里直接有图片 -> 整个文件夹 = 一本漫画
+    // 规则二: 否则 -> 每个含图片的子文件夹 = 该系列下的一话
+    func importFolder(at folderURL: URL) async -> Int {
+        let accessGranted = folderURL.startAccessingSecurityScopedResource()
+        defer {
+            if accessGranted { folderURL.stopAccessingSecurityScopedResource() }
+        }
+
+        let seriesName = sanitize(folderURL.lastPathComponent)
+
+        // 规则一: 根层直接有图片
+        let rootImages = imagesIn(folderURL)
+        if !rootImages.isEmpty {
+            guard let archiveURL = try? makeTemporaryArchive(images: rootImages) else { return 0 }
+            defer { try? FileManager.default.removeItem(at: archiveURL) }
+            do {
+                try await uploadFile(
+                    from: archiveURL,
+                    mangaName: seriesName,
+                    chapterName: seriesName,
+                    chapter: 1
+                )
+                return 1
+            } catch {
+                LogManager.logger.error("Failed to import folder \(seriesName): \(error)")
+                return 0
+            }
+        }
+
+        // 规则二: 子文件夹当话
+        var imported = 0
+        for (index, sub) in subfoldersIn(folderURL).enumerated() {
+            let images = imagesIn(sub)
+            guard !images.isEmpty else { continue }
+            guard let archiveURL = try? makeTemporaryArchive(images: images) else { continue }
+            defer { try? FileManager.default.removeItem(at: archiveURL) }
+
+            let chapterName = sanitize(sub.lastPathComponent)
+            let chapterNumber = LocalFileNameParser.getMangaChapterNumber(from: sub.lastPathComponent)
+                ?? Float(index + 1)
+            do {
+                try await uploadFile(
+                    from: archiveURL,
+                    mangaName: seriesName,
+                    chapterName: chapterName,
+                    chapter: chapterNumber
+                )
+                imported += 1
+            } catch {
+                LogManager.logger.error("Failed to import chapter \(chapterName): \(error)")
+            }
+        }
+        return imported
+    }
+
+    // 批量导入多个 cbz/zip, 系列名从文件名解析
+    func importArchives(_ urls: [URL]) async -> (success: Int, failed: Int) {
+        var success = 0
+        var failed = 0
+        for url in urls {
+            let accessGranted = url.startAccessingSecurityScopedResource()
+            defer {
+                if accessGranted { url.stopAccessingSecurityScopedResource() }
+            }
+            let parsed = LocalFileNameParser.parseMangaSeries(from: url.lastPathComponent)
+            let seriesName = sanitize(
+                parsed.isEmpty ? url.deletingPathExtension().lastPathComponent : parsed
+            )
+            do {
+                try await uploadFile(from: url, mangaName: seriesName)
+                success += 1
+            } catch {
+                LogManager.logger.error("Failed to import \(url.lastPathComponent): \(error)")
+                failed += 1
+            }
+        }
+        return (success, failed)
+    }
+}
